#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later

"""claudo-codo — patch Claude Code's native binary, set env, exec claude.

Same-length string replacements in both ASCII and UTF-16 LE encodings;
binary file size never changes.

Idempotent. Backs up to <binary>.original before first patch, and only if
every patch target is present — never backs up a partially-corrupted state.

Quiet on success (one line per binary). Loud on failure (refuses to exec).

To restore:  cp <binary>.original <binary>
Then re-run claudo-codo to repatch.
"""

from __future__ import annotations

import os
import re
import shutil
import sys
from dataclasses import dataclass
from enum import Enum
from pathlib import Path
from typing import NamedTuple


# ---------------------------------------------------------------------------
# Encoding support
# ---------------------------------------------------------------------------

# The native binary stores prompt strings in two encodings:
#   ASCII: em-dash appears as the JS escape — (six ASCII bytes)
#   UTF-16 LE: em-dash appears as the actual U+2014 codepoint (two bytes)
#
# Pad units are encoding-aware so trailing-space padding preserves alignment.
ENCODINGS = (
    ('ascii', lambda s: s.replace('—', '\\u2014').encode('ascii'), b' '),
    ('utf16', lambda s: s.encode('utf-16-le'), b' \x00'),
)


# ---------------------------------------------------------------------------
# Patch model
# ---------------------------------------------------------------------------

class Status(Enum):
    APPLICABLE = "OK"
    ALREADY    = "ALREADY"
    MISSING    = "NOT FOUND"


class Result(NamedTuple):
    """Classification of a single patch against a binary."""
    status: Status
    label: str
    occurrences: int


@dataclass(frozen=True)
class Patch:
    """A same-length binary string replacement across multiple encodings.

    Stores patch text as str.  At classify/apply time, encodes to each
    target encoding and pads the replacement to match the original's byte
    length.  Length budget is validated at construction time.
    """

    label: str
    old: str
    new: str

    def __post_init__(self):
        for enc_name, encode, pad_unit in ENCODINGS:
            old_b = encode(self.old)
            new_b = encode(self.new)
            deficit = len(old_b) - len(new_b)
            if deficit < 0:
                raise ValueError(
                    f"{self.label}: replacement exceeds original "
                    f"in {enc_name} ({len(new_b)}B > {len(old_b)}B)"
                )
            if deficit % len(pad_unit) != 0:
                raise ValueError(
                    f"{self.label}: deficit {deficit}B not divisible by "
                    f"pad unit {len(pad_unit)}B in {enc_name}"
                )

    def _encoded_pairs(self):
        """Yield (old_bytes, padded_replacement_bytes) for each encoding."""
        for _, encode, pad_unit in ENCODINGS:
            old_b = encode(self.old)
            new_b = encode(self.new)
            pad_count = (len(old_b) - len(new_b)) // len(pad_unit)
            yield old_b, new_b + pad_unit * pad_count

    def classify(self, data: bytes) -> Result:
        """Classify this patch against binary data.  Pure — no mutation."""
        any_applicable = False
        any_present = False
        total = 0
        for old_b, replacement in self._encoded_pairs():
            n_old = data.count(old_b)
            if n_old > 0:
                any_applicable = True
                total += n_old
            elif old_b != replacement:
                n_new = data.count(replacement)
                if n_new > 0:
                    any_present = True
                    total += n_new
        if any_applicable:
            return Result(Status.APPLICABLE, self.label, total)
        if any_present:
            return Result(Status.ALREADY, self.label, total)
        return Result(Status.MISSING, self.label, 0)

    def apply_to(self, data: bytearray) -> int:
        """Replace all occurrences across all encodings.  Mutates data."""
        count = 0
        for old_b, replacement in self._encoded_pairs():
            if old_b == replacement or data.find(old_b) < 0:
                continue
            i = 0
            while True:
                j = data.find(old_b, i)
                if j < 0:
                    break
                data[j:j + len(old_b)] = replacement
                count += 1
                i = j + len(replacement)
        return count


# ---------------------------------------------------------------------------
# Patch definitions — add, remove, or reorder entries here.
#
# Patches are plain str.  Em-dashes (—) are encoded per ENCODINGS above.
#
# ===========================================================================
# UPGRADE / RE-AUDIT RUNBOOK   (last run: 2.1.170 -> 2.1.220, 2026-07-24)
# ===========================================================================
# Claude Code is a Bun single-file ELF with the app bundled as MINIFIED JS in
# two encodings (ASCII with — for the em-dash + UTF-16LE). Bun RE-MINIFIES
# every build, so identifiers rotate: prose patches survive verbatim, but any
# patch matching a minified NAME (currently only #8) must be re-derived each
# upgrade. Still Bun as of 2.1.220 (Bun 1.4) — not a Rust rewrite, so this
# same-length byte-replacement approach stays valid.
#
# 1. DOWNLOAD + VERIFY (does not touch the running install):
#      BASE=https://downloads.claude.ai/claude-code-releases
#      VER=$(curl -fsSL $BASE/latest)                     # or .../stable
#      curl -fsSL $BASE/$VER/manifest.json                # per-platform sha256
#      curl -fsSL $BASE/$VER/linux-x64/claude -o claude-$VER
#      sha256sum claude-$VER   # == manifest .platforms["linux-x64"].checksum
#
# 2. DISSECT. Strings dump WITH byte offsets is the primary search surface:
#      strings -a -t d -n 6 claude-$VER > strings.txt     # ~40MB, greppable
#    Token -> offset:  grep -n 'PHRASE' strings.txt  (number after lineno = byte offset)
#    Read minified code around an offset (the bundle is on 40MB+ single lines,
#    so `grep -oE '.{0,N}'` backtracks/OOMs — use dd instead):
#      dd if=claude-$VER bs=1 skip=$((OFF-300)) count=800 status=none \
#        | tr -c '[:print:]' '\n' | grep -av '^$'
#    (System grep is ugrep; for raw-binary work use LC_ALL=C + grep -F/-aob.)
#
# 3. DRY-RUN classify every patch below BEFORE editing: import PATCHES from this
#    file, call p.classify(data) per patch. APPLICABLE=present, MISSING=renamed/
#    reworded. Any MISSING -> the on-launch patcher refuses to exec (safety).
#
# 4. RE-DERIVE name-based patches (#8 heron_brook getter; Ytf -> nO_ in 2.1.220):
#      grep -n tengu_heron_brook strings.txt   # find the accessor's code site
#    It returns a server-injected system-prompt string from clientDataCache/config.
#    2.1.220 added a 3rd branch returning a HARDCODED anti-proactivity directive
#    for Opus-5/Fable-5 with NO env kill-switch -> the patch is mandatory. Neuter =
#    replace the whole body with `return null` padded to the original byte length;
#    re-confirm occurrence count == 1.
#
# 5. RE-CHECK env/settings (see ENV_SET/ENV_CLEAR): telemetry/traffic master gate
#    is process.env-driven (DISABLE_TELEMETRY / DO_NOT_TRACK / DISABLE_GROWTHBOOK /
#    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC / DISABLE_ERROR_REPORTING — confirm
#    each still exists). Injection vectors stay env-killable: GrowthBook SDK
#    (DISABLE_GROWTHBOOK) + clientDataCache bootstrap fetch (NONESSENTIAL_TRAFFIC);
#    only heron_brook needs a patch. Watch for new brevity/"simple"/"fast" behavior
#    vars (-> ENV_CLEAR); confirm effort/thinking/[1m]-suffix vars still resolve.
#
# 6. VERIFY end-to-end: apply PATCHES to a COPY, re-classify (all ALREADY =
#    idempotent), confirm size byte-identical and neutered JS neighbors intact.
#
# 7. INSTALL: put the binary at ~/.local/share/claude/versions/<VER>, point the
#    ~/.local/bin/claude symlink at it (keep the previous version + its .original
#    for rollback). First `claudo-codo <model>` patches it (backs up .original).
#
# The reusable dryrun/verify harnesses from the last pass live in
# ~/.cache/claudo-codo-audit/ (dryrun.py, verify_new.py, win.sh, AUDIT-REPORT.md).
# ===========================================================================
# ---------------------------------------------------------------------------

